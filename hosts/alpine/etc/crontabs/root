# /etc/crontabs/root
#
# Alpine's stock crontab with the daily run moved from 02:00 to 22:00 so the
# restic backup (in /etc/periodic/daily) runs in the evening, matching when
# the live server actually takes its snapshots.
#
# min	hour	day	month	weekday	command
*/15	*	*	*	*	run-parts /etc/periodic/15min
0	*	*	*	*	run-parts /etc/periodic/hourly
0	22	*	*	*	run-parts /etc/periodic/daily
0	3	*	*	6	run-parts /etc/periodic/weekly
0	5	1	*	*	run-parts /etc/periodic/monthly
