# /etc/crontabs/root
#
# Alpine's stock crontab, unchanged. Kept in the repo so provisioning is
# explicit: the server runs on UTC, so the 02:00 daily run (restic backup,
# apk upgrades in /etc/periodic/daily) lands at ~22:00 Eastern, which is
# when snapshots actually appear.
#
# min	hour	day	month	weekday	command
*/15	*	*	*	*	run-parts /etc/periodic/15min
0	*	*	*	*	run-parts /etc/periodic/hourly
0	2	*	*	*	run-parts /etc/periodic/daily
0	3	*	*	6	run-parts /etc/periodic/weekly
0	5	1	*	*	run-parts /etc/periodic/monthly
