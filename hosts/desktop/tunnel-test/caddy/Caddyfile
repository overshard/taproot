# Tunnel test Caddy. No TLS and no ACME: the Cloudflare edge terminates HTTPS
# and cloudflared hands us plain HTTP on the bridge. This is the shape the real
# migration takes, minus every site block but one.
{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

http://test.bythewood.me {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	encode zstd gzip

	# Access logging is off by default in Caddy 2, which made the first run of
	# this rig blind. Console format so `docker logs` is readable.
	log {
		output stderr
		format console
	}

	reverse_proxy hello:8000
}

# Anything that reaches Caddy without a matching Host is not coming through the
# ingress rule, so say so loudly rather than serving the test app by accident.
:80 {
	log {
		output stderr
		format console
	}
	header -Server
	respond "tunnel-test caddy: no site block for this host" 404
}
