{
  "env": {
    "TZ": "America/New_York",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(*docker run*--privileged*)",
      "Bash(*docker run*-v /:*)",
      "Bash(*docker run*--volume /:*)",
      "Bash(*--pid=host*)",
      "Bash(*--cap-add=ALL*)",
      "Bash(*nsenter *)",
      "Bash(curl *| sh*)",
      "Bash(curl *| bash*)"
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/status-line.sh"
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "outputStyle": "Concise",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "verbose": false,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/taproot/dotfiles/claude/hooks/vault-capture.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/taproot/dotfiles/claude/hooks/vault-capture.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/taproot/dotfiles/claude/hooks/vault-capture.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/taproot/dotfiles/claude/hooks/vault-digest.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/taproot/dotfiles/claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
