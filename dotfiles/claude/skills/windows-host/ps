#!/usr/bin/env bash
# Run a PowerShell script on the Windows host from webdev, through WSL interop
# in a throwaway orchard-util container.
#
#   ps [--admin] <script.ps1 | ->
#
# --admin runs it elevated with Start-Process -Verb RunAs. That's silent only if
# UAC is set to elevate without prompting, otherwise a UAC prompt waits on the desktop.
set -euo pipefail

admin=0
if [ "${1:-}" = "--admin" ]; then admin=1; shift; fi
body=$(cat "${1:--}")

utf16b64() { iconv -f UTF-8 -t UTF-16LE | base64 -w0; }

if [ "$admin" = 1 ]; then
	log="claude-ps-$$-$RANDOM.log"
	inner=$(printf '$ProgressPreference = "SilentlyContinue"\n& {\n%s\n} *>&1 | Out-String -Width 400 | Out-File -FilePath "$env:TEMP\\%s" -Encoding utf8\n' "$body" "$log" | utf16b64)
	# The elevated process gets the script on its command line, which Windows caps at 32767 chars.
	if [ "${#inner}" -gt 32000 ]; then
		echo "script too long for --admin, split it up" >&2
		exit 1
	fi
	body=$(printf '%s\n' \
		"\$p = Start-Process powershell.exe -Verb RunAs -WindowStyle Hidden -Wait -PassThru -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-EncodedCommand','$inner'" \
		"\$f = \"\$env:TEMP\\$log\"" \
		"if (Test-Path \$f) { Get-Content \$f; Remove-Item \$f } else { 'no output from the elevated process' }" \
		"'exit=' + \$p.ExitCode")
fi

boot=$(printf '%s' '$ProgressPreference = "SilentlyContinue"; $s = [Console]::In.ReadToEnd(); & ([scriptblock]::Create($s)) *>&1 | Out-String -Stream -Width 400' | utf16b64)

printf '%s\n' "$body" | sudo docker run --rm -i --network host \
	--security-opt seccomp=unconfined \
	-v /mnt/c:/mnt/c:ro -v /run/WSL:/run/WSL -e WSL_INTEROP=/run/WSL/1_interop \
	-w /mnt/c/Windows orchard-util \
	/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -NonInteractive -EncodedCommand "$boot" \
	| tr -d '\r'
